{
  "manifest_version": 3,
  "name": "TOH Klas",
  "description": "Lets your teacher see which pages are open on this school computer, open or close them, and limit which sites can be visited during class.",
  "version": "0.2.0",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "alarms", "storage", "declarativeNetRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
