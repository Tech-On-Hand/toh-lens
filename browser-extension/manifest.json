{
  "manifest_version": 3,
  "name": "TOH Klas",
  "description": "Lets your teacher see which pages are open on this school computer during class and open, change, or close them.",
  "version": "0.1.0",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "alarms"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
